#!/usr/bin/env bash
set -euo pipefail

MODE="ro"
RESUME=""
PROJECT=""
PYTHON_ENV=""
CONFIG="${SAFE_OPENCODE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
DATA="${SAFE_OPENCODE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode}"
BWRAP="${SAFE_OPENCODE_BWRAP:-bwrap}"
CHECK_SERVICE=1
#Exposed host paths to mount in the sandbox
RO_PATHS=()
RW_PATHS=()
#Target mount points in the sandbox
RO_TARGETS=()
RW_TARGETS=()
LINK_PATHS=()
LINK_TARGETS=()
LINK_MODES=()
EXTRA_PATHS=()
LIBRARY_PATHS=()
DEVICE_PATHS=()
DRY_RUN=0
TMUX_ID=""

usage() {
    cat <<'EOF'
Usage:
  safe-opencode [OPTIONS] [PROJECT_DIR] [-- OPENCODE_ARGS...]

Options:
  --rw                    Mount the project read/write (default: read-only)
  --mount-ro HOST_PATH[=SANDBOX_PATH] Add a read-only host directory at SANDBOX_PATH (default: /mnt/host-ro/N)
  --mount-rw HOST_PATH[=SANDBOX_PATH] Add a read/write host directory at SANDBOX_PATH (default: /mnt/host-rw/N)
  --link-ro HOST_PATH TARGET Persist a project symlink and mount HOST_PATH read-only at its real host path
  --link-rw HOST_PATH TARGET Persist a project symlink and mount HOST_PATH read/write at its real host path
  --path PATH             Prepend a sandbox directory to PATH
  --library-path PATH     Prepend a sandbox directory to LD_LIBRARY_PATH
  --device PATH           Expose a host device under /dev
  --python-env PATH       Expose a Python environment read-only
  --config-dir PATH       Use a different host OpenCode config directory
  --data-dir PATH         Use a different host OpenCode data directory
  --bwrap PATH            Use a specific Bubblewrap executable
  --no-service-check      Skip the OpenCode service status check
  --resume                Continue the most recent session
  --resume ID             Resume a specific session
  --tmux AUDIT_ID         Start a separate tmux control shell in the sandbox
  --dry-run               Open an interactive shell in the sandbox without starting OpenCode
  --help, -h              Show this help

Mount sources must be existing directories. Without DEST, mounts use numbered
paths under /mnt/host-ro or /mnt/host-rw. Relative mount destinations are under
/workspace and require existing project directories without symlinks.
Absolute destinations must not replace built-in sandbox mounts.
Link TARGET is relative to PROJECT_DIR, with an existing parent directory.
Existing targets must be symlinks resolving to HOST_PATH; nothing is replaced.
Links and mounts below /workspace require --rw.
Links persist on the host.
Do not mount / or other broad, sensitive directories.
Note that --standalone provides isolation of the server, opencode creates a new session, and the sandbox is destroyed when the session ends.
Without --standalone, if there is running OpenCode service, the sandbox will connect to it and use its session which may not be isolated from the host. Use --standalone to ensure isolation.

Examples:
  safe-opencode . -- --standalone
  safe-opencode --rw . -- --standalone
  safe-opencode --mount-ro /data/reference --mount-rw /data/output . -- --standalone
  safe-opencode --mount-ro /opt/vendor/lib=/opt/vendor/lib --library-path /opt/vendor/lib . -- --standalone
  safe-opencode --python-env "$HOME/.venvs/project" --rw . -- --standalone
  safe-opencode --rw . -- --help
EOF
}

read_mount_spec() {
    local spec="$1"
    MOUNT_SOURCE="$spec"
    MOUNT_TARGET=""

    if [[ "$spec" == *=* ]]; then
        MOUNT_SOURCE="${spec%%=*}"
        MOUNT_TARGET="${spec#*=}"

        if [[ -z "$MOUNT_SOURCE" || -z "$MOUNT_TARGET" ]]; then
            echo "Error: named mount must be HOST_PATH=SANDBOX_PATH: $spec" >&2
            exit 2
        fi
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --rw)
            MODE="rw"
            shift
            ;;
        --link-ro|--link-rw)
            [[ $# -ge 3 && -n "$2" && -n "$3" && "$2" != --* && "$3" != --* ]] || {
                echo "Error: $1 requires HOST_PATH and TARGET" >&2
                exit 2
            }
            LINK_MODES+=("${1#--link-}")
            LINK_PATHS+=("$2")
            LINK_TARGETS+=("$3")
            shift 3
            ;;
        --mount-ro|--mount-rw|--python-env|--config-dir|--data-dir|--bwrap|--path|--library-path|--tmux)
            option="$1"
            [[ $# -ge 2 && -n "$2" ]] || {
                echo "Error: $option requires a path" >&2
                exit 2
            }
            case "$option" in
                --mount-ro)
                    read_mount_spec "$2"
                    RO_PATHS+=("$MOUNT_SOURCE")
                    RO_TARGETS+=("$MOUNT_TARGET")
                    ;;
                --mount-rw)
                    read_mount_spec "$2"
                    RW_PATHS+=("$MOUNT_SOURCE")
                    RW_TARGETS+=("$MOUNT_TARGET")
                    ;;
                --python-env) PYTHON_ENV="$2" ;;
                --config-dir) CONFIG="$2" ;;
                --data-dir) DATA="$2" ;;
                --bwrap) BWRAP="$2" ;;
                --path) EXTRA_PATHS+=("$2") ;;
                --library-path) LIBRARY_PATHS+=("$2") ;;
                --tmux) TMUX_ID="$2" ;;
            esac
            shift 2
            ;;
        --device)
            [[ $# -ge 2 && -n "$2" ]] || {
                echo "Error: --device requires a path" >&2
                exit 2
            }
            DEVICE_PATHS+=("$2")
            shift 2
            ;;
        --no-service-check)
            CHECK_SERVICE=0
            shift
            ;;
        --resume)
            if [[ $# -ge 2 && "$2" != -* ]]; then
                RESUME="$2"
                shift 2
            else
                RESUME="latest"
                shift
            fi
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            PROJECT="$1"
            shift
            break
            ;;
    esac
done

# Remove the separator after PROJECT_DIR before forwarding OpenCode arguments.
if [[ "${1:-}" == "--" ]]; then
    shift
fi

if [[ -n "$TMUX_ID" ]]; then
    if [[ ! "$TMUX_ID" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]]; then
        echo "Error: tmux audit ID must contain only letters, digits, underscores or hyphens and start with a letter or digit" >&2
        exit 2
    fi
    if [[ "$DRY_RUN" == 1 ]]; then
        echo "Error: --tmux cannot be combined with --dry-run" >&2
        exit 2
    fi
fi

PROJECT="$(realpath -e "${PROJECT:-.}")"
if [[ ! -d "$PROJECT" || "$PROJECT" == "/" ]]; then
    echo "Error: project must be a directory other than /: $PROJECT" >&2
    exit 1
fi

if [[ "$MODE" != rw && "${#LINK_PATHS[@]}" -gt 0 ]]; then
    echo "Error: --link-ro and --link-rw require --rw for the project" >&2
    exit 2
fi

check_link_target() {
    local source="$1" target="$2"
    if [[ -e "$target" || -L "$target" ]]; then
        if [[ ! -L "$target" ]] || [[ "$(realpath -e -- "$target")" != "$source" ]]; then
            printf 'Error: link target exists but is not a symlink to %s: %s\n' "$source" "$target" >&2
            exit 1
        fi
    fi
}

for i in "${!LINK_PATHS[@]}"; do
    source="$(realpath -e -- "${LINK_PATHS[$i]}")"
    if [[ ! -d "$source" || "$source" == / || "$source" == "$PROJECT" || "$source" == "$PROJECT/"* || "$PROJECT" == "$source/"* ]]; then
        printf 'Error: link source must be a directory separate from the project: %s\n' "$source" >&2
        exit 1
    fi
    target="${LINK_TARGETS[$i]}"
    if [[ "$target" == /* ]]; then
        printf 'Error: link target must be project-relative: %s\n' "$target" >&2
        exit 2
    fi
    target="$(realpath -ms -- "$PROJECT/$target")"
    parent="$(realpath -e -- "$(dirname -- "$target")")"
    if [[ "$target" != "$PROJECT/"* || ! -d "$parent" || ( "$parent" != "$PROJECT" && "$parent" != "$PROJECT/"* ) ]]; then
        printf 'Error: link target must have an existing parent inside the project: %s\n' "$target" >&2
        exit 1
    fi
    target="$parent/$(basename -- "$target")"
    check_link_target "$source" "$target"
    for previous in "${!LINK_TARGETS[@]}"; do
        [[ "$previous" -lt "$i" ]] || break
        if [[ "$target" == "${LINK_TARGETS[$previous]}" && "$source" != "${LINK_PATHS[$previous]}" ]]; then
            printf 'Error: conflicting link target: %s\n' "$target" >&2
            exit 1
        fi
    done
    LINK_PATHS[$i]="$source"
    LINK_TARGETS[$i]="$target"
    # Multiple links to the same source need only one mount per mode.
    duplicate=0
    for previous in "${!LINK_PATHS[@]}"; do
        [[ "$previous" -lt "$i" ]] || break
        if [[ "$source" == "${LINK_PATHS[$previous]}" && "${LINK_MODES[$i]}" == "${LINK_MODES[$previous]}" ]]; then
            duplicate=1
        fi
    done
    [[ "$duplicate" == 0 ]] || continue
    if [[ "${LINK_MODES[$i]}" == ro ]]; then
        RO_PATHS+=("$source")
        RO_TARGETS+=("$source")
    else
        RW_PATHS+=("$source")
        RW_TARGETS+=("$source")
    fi
done

normalize_mount_target() {
    local target="$1"
    if [[ "$target" != /* ]]; then
        target="$(realpath -ms -- "/workspace/$target")"
        if [[ "$target" != /workspace/* ]]; then
            printf 'Error: relative mount destination must stay inside the project: %s\n' "$1" >&2
            exit 1
        fi
    else
        target="$(realpath -ms -- "$target")"
    fi
	# Do not allow mounting directly onto /workspace, which would bypass the project directory.
	if [[ "$target" == /workspace ]]; then
	    echo "Error: cannot mount directly onto /workspace" >&2
	    exit 1
	fi
    if [[ "$target" == /workspace/* ]]; then
        if [[ "$MODE" != rw ]]; then
            echo "Error: mounts below /workspace require --rw for the project" >&2
            exit 2
        fi
        local host_target="$PROJECT/${target#/workspace/}"
		local host_parent
		host_parent="$(dirname -- "$host_target")"
		# Do not allow nested mounts
		if [[ ! -d "$host_parent" ]]; then
		    printf 'Error: project mount destination parent must already be a directory: %s\n' \
		        "$host_parent" >&2
		    exit 1
		fi
        if [[ "$(realpath -m -- "$host_target")" != "$host_target" ||
              ( -e "$host_target" && ! -d "$host_target" ) ]]; then
            printf 'Error: project mount destination must be a directory path without symlinks: %s\n' "$host_target" >&2
            exit 1
        fi
		# If the target directory exists, it must be empty and accessible.
		if [[ -d "$host_target" ]]; then
		    if [[ ! -r "$host_target" || ! -x "$host_target" ]]; then
		        printf 'Error: cannot inspect project mount destination: %s\n' \
		            "$host_target" >&2
		        exit 1
		    fi
		    if ! (
		        shopt -s nullglob dotglob
		        entries=("$host_target"/*)
		        [[ "${#entries[@]}" -eq 0 ]]
		    ); then
		        printf 'Error: project mount destination must be empty: %s\n' \
		            "$host_target" >&2
		        exit 1
		    fi
		fi
    fi
    printf '%s\n' "$target"
}

for i in "${!RO_PATHS[@]}"; do
    RO_PATHS[$i]="$(realpath -e "${RO_PATHS[$i]}")"
    if [[ ! -d "${RO_PATHS[$i]}" || "${RO_PATHS[$i]}" == "/" ]]; then
        echo "Error: read-only mount must be a directory other than /: ${RO_PATHS[$i]}" >&2
        exit 1
    fi
    if [[ -n "${RO_TARGETS[$i]}" ]]; then
        RO_TARGETS[$i]="$(normalize_mount_target "${RO_TARGETS[$i]}")"
    fi
done

for i in "${!RW_PATHS[@]}"; do
    RW_PATHS[$i]="$(realpath -e "${RW_PATHS[$i]}")"
    if [[ ! -d "${RW_PATHS[$i]}" || "${RW_PATHS[$i]}" == "/" ]]; then
        echo "Error: read/write mount must be a directory other than /: ${RW_PATHS[$i]}" >&2
        exit 1
    fi
    if [[ -n "${RW_TARGETS[$i]}" ]]; then
        RW_TARGETS[$i]="$(normalize_mount_target "${RW_TARGETS[$i]}")"
    fi
done

RESERVED_MOUNTS=(/usr /bin /lib /lib64 /etc/hosts /etc/resolv.conf /etc/nsswitch.conf /etc/pki /etc/ssl /tmp /dev /proc /workspace /sandbox-config /sandbox-data /opt/opencode-bin /mnt/host-ro /mnt/host-rw)
if [[ -n "$TMUX_ID" ]]; then
    RESERVED_MOUNTS+=(/run/safe-code-audit /opt/safe-code-tmux)
fi
NAMED_TARGETS=()
for target in "${RO_TARGETS[@]}" "${RW_TARGETS[@]}"; do
    [[ -n "$target" ]] || continue
    if [[ "$target" == "/" ]]; then
        echo "Error: named mount destination must not be /" >&2
        exit 1
    fi
    for reserved in "${RESERVED_MOUNTS[@]}"; do
        [[ "$reserved" == /workspace && "$target" == /workspace/* ]] && continue
        if [[ "$target" == "$reserved" || "$target" == "$reserved/"* || "$reserved" == "$target/"* ]]; then
            printf 'Error: named mount destination conflicts with built-in sandbox path %s: %s\n' "$reserved" "$target" >&2
            exit 1
        fi
    done
    for existing in "${NAMED_TARGETS[@]}"; do
        if [[ "$target" == "$existing" || "$target" == "$existing/"* || "$existing" == "$target/"* ]]; then
            printf 'Error: duplicate or overlapping named mount destination: %s\n' "$target" >&2
            exit 1
        fi
    done
    NAMED_TARGETS+=("$target")
done

for path in "${EXTRA_PATHS[@]}" "${LIBRARY_PATHS[@]}"; do
    if [[ "$path" != /* || "$path" == *:* ]]; then
        printf 'Error: PATH entries must be absolute sandbox paths without colons: %s\n' "$path" >&2
        exit 2
    fi
done

if [[ -n "$PYTHON_ENV" ]]; then
    PYTHON_ENV="$(realpath -e "$PYTHON_ENV")"
    if [[ ! -d "$PYTHON_ENV" || ! -x "$PYTHON_ENV/bin/python" ]]; then
        echo "Error: Python environment must contain an executable bin/python: $PYTHON_ENV" >&2
        exit 1
    fi
fi

for i in "${!DEVICE_PATHS[@]}"; do
    DEVICE_PATHS[$i]="$(realpath -e "${DEVICE_PATHS[$i]}")"
    if [[ "${DEVICE_PATHS[$i]}" != /dev/* ]] ||
       [[ ! -c "${DEVICE_PATHS[$i]}" && ! -d "${DEVICE_PATHS[$i]}" ]]; then
        echo "Error: device must be a character device or directory under /dev: ${DEVICE_PATHS[$i]}" >&2
        exit 1
    fi
done

OPENCODE="$(command -v opencode || true)"
if [[ -z "$OPENCODE" ]]; then
    echo "Error: opencode not found in PATH" >&2
    exit 1
fi
OPENCODE="$(readlink -f "$OPENCODE")"
OPENCODE_DIR="$(dirname "$OPENCODE")"
OPENCODE_NAME="$(basename "$OPENCODE")"

if ! command -v "$BWRAP" >/dev/null 2>&1; then
    echo "Error: Bubblewrap executable not found: $BWRAP" >&2
    exit 1
fi
BWRAP="$(command -v "$BWRAP")"

CONFIG="$(realpath -m "$CONFIG")"
DATA="$(realpath -m "$DATA")"
mkdir -p "$CONFIG" "$DATA"

if [[ "$CHECK_SERVICE" == 1 && "$DRY_RUN" == 0 ]]; then
    if SERVICE_STATUS="$("$OPENCODE" service status 2>&1)"; then
        printf 'OpenCode service status: %s\n' "${SERVICE_STATUS:-available}"
        if [[ "$SERVICE_STATUS" != "stopped" ]]; then
            printf 'An OpenCode background service is running outside the sandbox. Stop it before continuing? [y/N] ' >&2
            if ! IFS= read -r reply || [[ ! "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]; then
                echo "Aborted: the host OpenCode service was not stopped." >&2
                exit 1
            fi
            if ! "$OPENCODE" service stop; then
                echo "Error: failed to stop the host OpenCode service." >&2
                exit 1
            fi
            if ! SERVICE_STATUS="$("$OPENCODE" service status 2>&1)"; then
                printf 'Error: could not verify the host OpenCode service stopped: %s\n' "$SERVICE_STATUS" >&2
                exit 1
            fi
            if [[ "$SERVICE_STATUS" != "stopped" ]]; then
                printf 'Error: host OpenCode service is not stopped: %s\n' "$SERVICE_STATUS" >&2
                exit 1
            fi
        fi
    else
        printf 'OpenCode service status unavailable: %s\n' "${SERVICE_STATUS:-no status returned}" >&2
    fi
fi

ARGS=(
    --die-with-parent
    --new-session
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --dir /tmp/home
    --dir /tmp/cache
    --dir /etc
)

for dev in "${DEVICE_PATHS[@]}"; do
    ARGS+=(--dev-bind "$dev" "$dev")
done

for d in /lib /lib64; do
    if [[ -e "$d" ]]; then
        ARGS+=(--ro-bind "$d" "$d")
    fi
done

for f in /etc/hosts /etc/resolv.conf /etc/nsswitch.conf; do
    if [[ -e "$f" ]]; then
        ARGS+=(--ro-bind "$(readlink -f "$f")" "$f")
    fi
done

for d in /etc/pki /etc/ssl; do
    if [[ -d "$d" ]]; then
        ARGS+=(--ro-bind "$d" "$d")
    fi
done

ARGS+=(--dir /workspace)
if [[ "$MODE" == "rw" ]]; then
    ARGS+=(--bind "$PROJECT" /workspace)
else
    ARGS+=(--ro-bind "$PROJECT" /workspace)
fi
# For read/write:

ARGS+=(
    --dir /sandbox-config
    --bind "$CONFIG" /sandbox-config/opencode
    --dir /sandbox-data
    --bind "$DATA" /sandbox-data/opencode
    --dir /opt
    --ro-bind "$OPENCODE_DIR" /opt/opencode-bin
    --dir /mnt
    --dir /mnt/host-ro
    --dir /mnt/host-rw
)
DIRS_ADDED=(/tmp /tmp/home /tmp/cache /etc /workspace /sandbox-config /sandbox-data /opt /mnt /mnt/host-ro /mnt/host-rw)

ensure_parent_dirs() {
    local path="$1"
    local parent
    local component
    local known
    local current=""
    local -a components=()

    parent="$(dirname "$path")"
    IFS='/' read -r -a components <<< "$parent"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        current+="/$component"
        for known in "${DIRS_ADDED[@]}"; do
            [[ "$current" == "$known" ]] && continue 2
        done
        ARGS+=(--dir "$current")
        DIRS_ADDED+=("$current")
    done
}

for i in "${!RO_PATHS[@]}"; do
    target="${RO_TARGETS[$i]}"
    if [[ -z "$target" ]]; then
        target="/mnt/host-ro/$((i + 1))"
    else
        ensure_parent_dirs "$target"
    fi
    ARGS+=(--dir "$target" --ro-bind "${RO_PATHS[$i]}" "$target")
    DIRS_ADDED+=("$target")
done

for i in "${!RW_PATHS[@]}"; do
    target="${RW_TARGETS[$i]}"
    if [[ -z "$target" ]]; then
        target="/mnt/host-rw/$((i + 1))"
    else
        ensure_parent_dirs "$target"
    fi
    ARGS+=(--dir "$target" --bind "${RW_PATHS[$i]}" "$target")
    DIRS_ADDED+=("$target")
done

PATH_VALUE="/opt/opencode-bin:/usr/local/bin:/usr/bin:/bin"
EXTRA_PATH_VALUE=""
for path in "${EXTRA_PATHS[@]}"; do
    EXTRA_PATH_VALUE="${EXTRA_PATH_VALUE:+$EXTRA_PATH_VALUE:}$path"
done
if [[ -n "$EXTRA_PATH_VALUE" ]]; then
    PATH_VALUE="$EXTRA_PATH_VALUE:$PATH_VALUE"
fi
if [[ -n "$PYTHON_ENV" ]]; then
    ensure_parent_dirs "$PYTHON_ENV"
    ARGS+=(--ro-bind "$PYTHON_ENV" "$PYTHON_ENV")
    PATH_VALUE="$PYTHON_ENV/bin:$PATH_VALUE"
    ARGS+=(--setenv VIRTUAL_ENV "$PYTHON_ENV")
fi

if [[ "${#LIBRARY_PATHS[@]}" -gt 0 ]]; then
    LIBRARY_PATH_VALUE=""
    for path in "${LIBRARY_PATHS[@]}"; do
        LIBRARY_PATH_VALUE="${LIBRARY_PATH_VALUE:+$LIBRARY_PATH_VALUE:}$path"
    done
    ARGS+=(--setenv LD_LIBRARY_PATH "$LIBRARY_PATH_VALUE")
fi

ARGS+=(
    --setenv HOME /tmp/home
    --setenv XDG_CONFIG_HOME /sandbox-config
    --setenv XDG_DATA_HOME /sandbox-data
    --setenv XDG_CACHE_HOME /tmp/cache
    --setenv TMPDIR /tmp
    --setenv PATH "$PATH_VALUE"
    --chdir /workspace
)

OC_ARGS=()
if [[ "$RESUME" == "latest" ]]; then
    OC_ARGS+=(--continue)
elif [[ -n "$RESUME" ]]; then
    OC_ARGS+=(--session "$RESUME")
fi
OC_ARGS+=("$@")

STANDALONE=0
for arg in "${OC_ARGS[@]}"; do
    if [[ "$arg" == "--standalone" ]]; then
        STANDALONE=1
        break
    fi
done
if [[ "$STANDALONE" == 0 && "$DRY_RUN" == 0 ]]; then
    cat >&2 <<'EOF'
WARNING: OpenCode is not being started with --standalone.
It may connect to or start a background service outside this sandbox, which can
bypass Bubblewrap filesystem isolation. Add "-- --standalone" to keep the
OpenCode server inside the sandbox.
EOF
fi

for i in "${!LINK_PATHS[@]}"; do
    check_link_target "${LINK_PATHS[$i]}" "${LINK_TARGETS[$i]}"
done
for i in "${!LINK_PATHS[@]}"; do
    if [[ ! -L "${LINK_TARGETS[$i]}" ]]; then
        ln -sT -- "${LINK_PATHS[$i]}" "${LINK_TARGETS[$i]}"
    fi
    printf 'Persistent link: %s -> %s\n' "${LINK_TARGETS[$i]}" "${LINK_PATHS[$i]}"
done

echo "Project: $PROJECT ($MODE)"
for i in "${!RO_PATHS[@]}"; do
    target="${RO_TARGETS[$i]:-/mnt/host-ro/$((i + 1))}"
    printf 'Read-only mount: %s -> %s\n' "${RO_PATHS[$i]}" "$target"
done
for i in "${!RW_PATHS[@]}"; do
    target="${RW_TARGETS[$i]:-/mnt/host-rw/$((i + 1))}"
    printf 'Read/write mount: %s -> %s\n' "${RW_PATHS[$i]}" "$target"
done
for path in "${EXTRA_PATHS[@]}"; do
    printf 'PATH entry: %s\n' "$path"
done
for path in "${LIBRARY_PATHS[@]}"; do
    printf 'Library path: %s\n' "$path"
done
if [[ -n "$PYTHON_ENV" ]]; then
    echo "Python environment: $PYTHON_ENV (read-only)"
fi
for dev in "${DEVICE_PATHS[@]}"; do
    printf 'Device: %s\n' "$dev"
done
echo "Resume: ${RESUME:-new session}"

print_prompt_context() {
    printf 'Sandbox start time: %s\n' "$(date --iso-8601=seconds)"
    echo "Use only the files and paths available in this sandbox. The project is /workspace ($MODE)."

    for i in "${!RO_PATHS[@]}"; do
        target="${RO_TARGETS[$i]:-/mnt/host-ro/$((i + 1))}"
        echo "Host reference directory $target is read-only."
    done

    for i in "${!RW_PATHS[@]}"; do
        target="${RW_TARGETS[$i]:-/mnt/host-rw/$((i + 1))}"
        echo "Host output directory $target is writable; keep changes there unless asked otherwise."
    done

    if [[ -n "$PYTHON_ENV" ]]; then
        echo "Python is available from the read-only environment at $PYTHON_ENV/bin/python."
    fi

    for path in "${EXTRA_PATHS[@]}"; do
        echo "Executable directory available at $path."
    done

    for path in "${LIBRARY_PATHS[@]}"; do
        echo "Shared libraries are available from $path."
    done
}

if [[ "$DRY_RUN" == 1 ]]; then
    echo "Environment context:"
    print_prompt_context
else
    echo "Environment context to be passed to OpenCode, saved to $PROJECT/PROMPT_CONTEXT:"
    PROMPT_CONTEXT="$PROJECT/PROMPT_CONTEXT"
    print_prompt_context | tee "$PROMPT_CONTEXT"
fi


if [[ "$DRY_RUN" == 1 ]]; then
    echo "Dry run: starting an interactive shell in the sandbox without starting OpenCode."
    exec "$BWRAP" "${ARGS[@]}" /bin/bash --noprofile --norc -i
else
    echo "Starting OpenCode in the sandbox..."
    if [[ -z "$TMUX_ID" ]]; then
        exec "$BWRAP" "${ARGS[@]}" \
            "/opt/opencode-bin/$OPENCODE_NAME" \
            "${OC_ARGS[@]}"
    fi
    source "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")/safe-code-tmux"
    run_with_tmux "$BWRAP" "/opt/opencode-bin/$OPENCODE_NAME" "${OC_ARGS[@]}"
fi
